{
  "name": "vexim-trade-crm",
  "version": "0.1.0",
  "private": true,
  "description": "CRM phòng sale xuất khẩu - Vexim Trade",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "typecheck": "tsc --noEmit",
    "check:supabase": "node scripts/check-supabase.mjs",
    "check:ai-crawl": "node scripts/check-ai-crawlability.mjs",
    "check:mail": "node --experimental-strip-types --no-warnings scripts/check-mail-visibility.mjs",
    "check:harvest": "node --experimental-strip-types --no-warnings scripts/check-harvest-calendar.mjs && node --experimental-strip-types --no-warnings scripts/check-harvest-research.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "2.1.1",
    "dompurify": "^3.4.17",
    "lucide-react": "1.52.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.32.1",
    "sanitize-html": "^2.18.1",
    "server-only": "0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "3.7.0",
    "xlsx": "^0.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/dompurify": "^3.0.5",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
